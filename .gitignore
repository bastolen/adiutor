# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# testing
# Vitest's JSON reporter output (e.g. from the editor extension)
/.vitest/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
.pnpm-debug.log*

# env files (the example one is committed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testing (Vitest and Playwright output)
/test-results/
/playwright-report/

# local database files (the docker folder itself is committed)
/docker/*
!/docker/.gitkeep

# end-to-end test emails
/e2e/.outbox/

# end-to-end test attachments
/e2e/.attachments/


# Personal notes or local files
/.personal/
/.local/
# Claude Security scan reports (each folder also ignores itself)
CLAUDE-SECURITY-*

# Other checkouts of the repository that Claude Code sessions work in. Ignored here (not only in
# a local exclude) so Prettier, which reads this file, never formats them from this checkout.
.claude/worktrees/
