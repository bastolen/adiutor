# Copy to `.env` and fill in. `.env` is git-ignored; never commit real secrets.

# PostgreSQL connection string. This matches the local database from `pnpm services:up`.
DATABASE_URL=postgresql://adiutor:adiutor@localhost:5432/adiutor

# Secret for signing and encrypting auth data, at least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional: versioned secrets to rotate BETTER_AUTH_SECRET, newest first, e.g. "2:new-secret,1:old-secret".
# Keep BETTER_AUTH_SECRET as it was. See "Rotating the auth secret" in docs/deploying.md.
BETTER_AUTH_SECRETS=

# Public base URL of the app. In production it must be https://… (the app refuses http:// there,
# except on localhost). `pnpm db:seed` only runs while it's on this computer (localhost).
BETTER_AUTH_URL=http://localhost:3000

# The secret the background jobs' endpoint (/api/jobs) asks for, at least 32 characters.
# A Vercel schedule sends it by itself; an external cron service sends it as "Authorization: Bearer …".
# Set it in development too: `pnpm dev` calls the endpoint with it every minute, so queued emails reach
# Mailpit. Left empty, the endpoint is off and only `pnpm jobs:run` starts the jobs. See docs/jobs.md.
# Generate one with: openssl rand -base64 32
CRON_SECRET=

# Set by Vercel itself once Protection Bypass for Automation has a secret: the jobs' endpoint sends it
# when it continues a tick on a protected Preview deployment. Leave it empty elsewhere.
VERCEL_AUTOMATION_BYPASS_SECRET=

# GitHub sign-in (optional). Create an OAuth app at https://github.com/settings/developers
# with callback URL: http://localhost:3000/api/auth/callback/github
# GitHub's 2FA counts as MFA only while these are set (see docs/deploying.md).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google sign-in (optional). Create an OAuth client at https://console.cloud.google.com/apis/credentials
# with redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (magic links, password resets, invitations). Set here, the mail server wins over the one a
# staff Admin sets up on the Email tab of Settings, which then only shows it; leave both empty to
# set it up there. The default sends to Mailpit from `pnpm services:up`, which shows every email at
# http://localhost:8025. In production use your provider with TLS, e.g.
# smtps://user:password@smtp.adiutor.dev:465, or
# smtp://user:password@smtp.adiutor.dev:587?requireTLS=true for STARTTLS: the app refuses a plain
# smtp:// URL to another computer in production. Without any mail server in development, emails
# are printed to the server console instead.
SMTP_URL=smtp://localhost:1025
# The sender, which wins over the one saved in Settings. Set it to an address on a domain you
# control in production.
EMAIL_FROM=Adiutor <no-reply@adiutor.dev>

# Database for integration and end-to-end tests (created automatically, and emptied by the tests).
# Defaults to DATABASE_URL with the database name replaced by adiutor_test. Its name must end in
# _test, and it can't be the database in DATABASE_URL.
DATABASE_URL_TEST=

# The port the end-to-end tests start their own server on. Leave empty for 3100. Give a second
# checkout of the repository another port, and a test database of its own above, and both can run
# the tests at the same time.
E2E_PORT=

# Write emails to this folder as JSON instead of sending them. Used by the end-to-end tests; leave
# empty for normal development. Refused in production (unless E2E_TESTS=1).
EMAIL_OUTBOX_DIR=

# Set to 1 only by the end-to-end test server (playwright.config.ts), never in development or
# production: it lets EMAIL_OUTBOX_DIR work in a production build.
E2E_TESTS=

# Where the client's IP address comes from, for rate limits, the audit log and security emails.
# See "Client IP address" in docs/deploying.md for VPS + Docker + proxy and Vercel setups.
# Headers to read, in order (default x-forwarded-for, which works on Vercel); e.g. x-real-ip behind
# a reverse proxy that sets it, or cf-connecting-ip behind Cloudflare.
CLIENT_IP_HEADERS=
# IP addresses or CIDR ranges of your reverse proxies, comma-separated, e.g. 10.0.0.5,10.0.1.0/24.
# With them, X-Forwarded-For is read from the right, skipping them; without them, only a
# single-value IP header is trusted.
TRUSTED_PROXIES=

# Where attached files are kept (see "Attachments" in docs/deploying.md): local (a folder), s3 (an
# S3-compatible bucket) or sftp (a folder on another server), or off. Leave empty to choose it on the
# Attachments tab of Settings; set, it wins there, and off keeps staff Admins from choosing one.
ATTACHMENTS_STORAGE=
# For local: an absolute folder that exists, e.g. /data/attachments (a volume in Docker).
ATTACHMENTS_DIR=
# For s3: the service's address, the region (auto on Cloudflare R2; us-east-1 when empty), the
# bucket and the access key's ID and secret, and true for path-style addresses, which most servers
# of your own (Garage, SeaweedFS) need. To try it locally with the s3 service in compose.yaml:
# http://localhost:8333, bucket adiutor, keys adiutor and adiutor-test-secret, path style true.
ATTACHMENTS_S3_ENDPOINT=
ATTACHMENTS_S3_REGION=
ATTACHMENTS_S3_BUCKET=
ATTACHMENTS_S3_ACCESS_KEY_ID=
ATTACHMENTS_S3_SECRET_ACCESS_KEY=
ATTACHMENTS_S3_FORCE_PATH_STYLE=
# For sftp: the server, its SSH port (22 when empty), the user, its password or its private key (the
# PEM file in base64: base64 < key), the server's host key fingerprint as ssh-keygen -lf prints it
# (SHA256:...), and an absolute folder there. To try it locally with the sftp service in
# compose.yaml: localhost, port 2222, user adiutor, password adiutor-test-secret, folder /config
# (the user's home), and the fingerprint from: ssh-keyscan -p 2222 localhost | ssh-keygen -lf -
ATTACHMENTS_SFTP_HOST=
ATTACHMENTS_SFTP_PORT=
ATTACHMENTS_SFTP_USERNAME=
ATTACHMENTS_SFTP_PASSWORD=
ATTACHMENTS_SFTP_PRIVATE_KEY=
ATTACHMENTS_SFTP_HOST_KEY=
ATTACHMENTS_SFTP_DIR=
# The largest file anyone may attach, in megabytes: 1 to 50, at most 4 on Vercel. Leave empty to
# choose it on the Attachments tab of Settings (10 until changed).
ATTACHMENTS_MAX_FILE_MB=

# Networks inside your own that webhooks may still send to, as IP addresses or CIDR ranges,
# comma-separated, e.g. 10.20.0.0/16 for a receiver on the local network. Without it, webhooks
# never reach a private, loopback or link-local address. See "Webhooks" in docs/deploying.md.
WEBHOOK_ALLOWED_NETWORKS=
