{
  "name": "adiutor",
  "version": "0.4.0",
  "description": "A shared service desk where companies raise requests and work them through with the staff.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bastolen/adiutor.git"
  },
  "engines": {
    "node": ">=26.13"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "email:dev": "email dev --dir src/emails --port 3001",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 && stylelint \"**/*.css\" --max-warnings=0 && pnpm lint:messages",
    "lint:messages": "i18n-check --locales src/messages --source en-US --format next-intl && i18n-check --locales src/messages --source en-US --format next-intl --only unused undefined --unused src --ignore \"tables.*\" \"roles.*\" \"audit.*\" \"jobs.*\" \"auth.codes.*\" \"errors.*\" \"validation.*\" \"emails.*\"",
    "lint:fix": "eslint . --fix && stylelint \"**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:schema": "node --env-file-if-exists=.env --import tsx scripts/generate-auth-schema.ts",
    "setup:platform": "node --env-file-if-exists=.env --import tsx scripts/setup-platform.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed-dev.ts",
    "jobs:run": "node --env-file-if-exists=.env --import tsx scripts/jobs.ts run",
    "jobs:list": "node --env-file-if-exists=.env --import tsx scripts/jobs.ts list",
    "jobs:retry": "node --env-file-if-exists=.env --import tsx scripts/jobs.ts retry",
    "jobs:discard": "node --env-file-if-exists=.env --import tsx scripts/jobs.ts discard",
    "sessions:revoke-all": "node --env-file-if-exists=.env --import tsx scripts/revoke-sessions.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.25",
    "@formatjs/intl-localematcher": "^0.10.1",
    "better-auth": "^1.7.12",
    "clsx": "^2.1.1",
    "cron-parser": "5.10.6",
    "drizzle-orm": "^0.45.4",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "lucide-react": "^1.61.0",
    "negotiator": "^1.1.0",
    "next": "16.4.6",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.2.0",
    "pg": "^8.23.1",
    "pg-connection-string": "2.14.1",
    "qrcode": "1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.16",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5",
    "use-intl": "^4.14.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.39.5",
    "@lingual/i18n-check": "^0.9.5",
    "@playwright/test": "^1.64.1",
    "@react-email/ui": "6.11.16",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "auth": "^1.7.12",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-airbnb-extended": "^3.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-jsdoc": "^65.4.0",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-prettier": "^5.0.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
