/**
 * Renovate configuration: opens pull requests to keep the npm packages, the
 * container images (workflows, compose.yaml and the Dockerfile), `.nvmrc` and
 * the pnpm version up to date. GitHub Actions are Dependabot's (.github/dependabot.yml). Requires the Renovate GitHub app to be installed
 * on the repository.
 *
 * Renovate uses pnpm, like local development: it finds `pnpm-lock.yaml`, and
 * runs the pnpm version from `packageManager` in package.json (which pnpm
 * also switches to locally), with the settings in pnpm-workspace.yaml. When
 * it updates `packageManager`, everyone's pnpm follows.
 *
 * @see https://docs.renovatebot.com/configuration-options/
 */
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    /** Renovate's recommended defaults. */
    'config:recommended',
  ],
  /** Open update PRs once a week, so they arrive in batches. */
  schedule: ['before 6am on monday'],
  timezone: 'Europe/Amsterdam',
  /**
   * Wait 3 days after a release before updating, in case it is pulled or
   * compromised. Shown on each PR as the `renovate/stability-days` check;
   * image digests and lockfile refreshes have their own rule below.
   */
  minimumReleaseAge: '3 days',
  /** Refresh the lockfile weekly, picking up updates to indirect dependencies. */
  lockFileMaintenance: { enabled: true },
  /**
   * Major updates wait for approval: Renovate lists them under "Pending Approval" in the
   * Dependency Dashboard issue and opens the PR once its box is ticked. A major often waits on
   * the tools around it (typescript-eslint for TypeScript, plugins for ESLint), and an open PR
   * that can't pass yet reruns CI every time a merge changes the lockfile. Security fixes don't
   * wait.
   */
  major: { dependencyDashboardApproval: true },
  /** Conventional Commit messages, matching commitlint. */
  semanticCommits: 'enabled',
  packageRules: [
    {
      /** Actions and reusable workflows are updated by Dependabot. */
      matchManagers: ['github-actions'],
      matchDepTypes: ['action', 'workflow'],
      enabled: false,
    },
    {
      /** Workflow container images (CI's PostgreSQL) stay pinned to a digest. */
      matchManagers: ['github-actions'],
      matchDatasources: ['docker'],
      pinDigests: true,
    },
    {
      /** The Dockerfile's base image (Node.js) stays pinned to a digest, its version in the tag. */
      matchManagers: ['dockerfile'],
      pinDigests: true,
    },
    {
      /**
       * Image digest updates and lockfile refreshes carry no release date that
       * the `renovate/stability-days` check can read, and without one the
       * default (`timestamp-required`) keeps the check pending forever. Here a
       * missing date passes instead. Digest PRs still wait: Renovate only opens
       * or updates them 3 days after Docker Hub pushed the tag. Lockfile
       * refreshes get no wait from Renovate; pnpm's built-in default still
       * skips versions younger than a day when it resolves them.
       */
      matchUpdateTypes: ['digest', 'pinDigest', 'lockFileMaintenance'],
      minimumReleaseAgeBehaviour: 'timestamp-optional',
    },
    {
      /**
       * highlight.js stays on the version lowlight depends on (`~11.11`), so the app loads one
       * copy and the grammars run on the version they were written for. Raise this, and the
       * range in `package.json`, when lowlight moves.
       */
      matchPackageNames: ['highlight.js'],
      allowedVersions: '~11.11.0',
    },
    {
      /** Group all minor and patch updates into one PR. */
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'all non-major dependencies',
      groupSlug: 'all-minor-patch',
    },
    {
      /**
       * Major updates of Next.js, React and their type packages move together. Their minor and
       * patch updates join the non-major group above, so most weeks bring one PR fewer.
       */
      matchPackageNames: ['next', 'react', 'react-dom', '@types/react', '@types/react-dom'],
      matchUpdateTypes: ['major'],
      groupName: 'Next.js and React',
    },
  ],
}
